{
  "expo": {
    "name": "Forma",
    "slug": "forma",
    "scheme": "forma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "icon": "./assets/ios-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.forma.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to process video frames for MediaPipe pose detection.",
        "NSPhotoLibraryUsageDescription": "Choose a profile photo from your photo library.",
        "NSPhotoLibraryAddUsageDescription": "Save workout recordings to your photo library.",
        "NSMicrophoneUsageDescription": "Record audio during workout screen recordings.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "package": "com.forma.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "WRITE_EXTERNAL_STORAGE",
        "FOREGROUND_SERVICE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "forma"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-image-picker",
      [
        "expo-media-library",
        {
          "photosPermission": "Save workout recordings to your photo library.",
          "savePhotosPermission": "Save workout recordings to your photo library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "jsEngine": "jsc"
          },
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      [
        "./plugins/withGradleJavaHome",
        "/Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home"
      ]
    ]
  }
}

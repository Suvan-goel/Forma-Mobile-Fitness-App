# ElevenLabs API key is server-side only.
# Set ELEVENLABS_API_KEY as a Supabase Edge Function secret, never as EXPO_PUBLIC_*.

# Optional: Voice ID (default: Rachel)
# Browse voices at https://elevenlabs.io/voice-library
# EXPO_PUBLIC_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Supabase — Phase 1 (Auth + Workouts)
# Create a project at https://supabase.com and copy the URL + anon key
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

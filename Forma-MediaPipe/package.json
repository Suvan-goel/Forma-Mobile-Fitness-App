{
  "name": "forma",
  "version": "1.0.0",
  "main": "App.tsx",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --dev-client",
    "start:tunnel": "expo start --dev-client --tunnel",
    "start:tunnel:recordings": "node scripts/start-with-recording-capture.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "recordings:server": "node scripts/recording-server.js",
    "dataset:download-repcount": "python3 scripts/download-repcount.py",
    "dataset:extract": "python3 scripts/extract-video-landmarks.py",
    "dataset:prepare": "node scripts/run-dataset-command.js prepare",
    "dataset:draft-label": "node scripts/run-dataset-command.js draft-label",
    "dataset:evaluate": "FORMA_RUN_DATASET_EVALUATE=1 jest scripts/dataset-evaluate.ts --runInBand --no-coverage --verbose",
    "dataset:optimize": "tsx scripts/dataset-optimize-cli.ts",
    "dataset:optimize:exercise": "tsx scripts/dataset-optimize-cli.ts",
    "ml:export": "tsx scripts/ml-export-dataset.ts",
    "ml:train": "python3 scripts/ml-train.py",
    "ml:evaluate": "python3 scripts/ml-evaluate.py",
    "postinstall": "patch-package && node scripts/fix-ios-jsc.js",
    "prebuild:ios": "expo prebuild --platform ios --clean && node scripts/fix-ios-jsc.js && cd ios && pod install",
    "test": "jest",
    "replay": "jest scripts/replay.ts --no-coverage --verbose"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.1",
    "@expo-google-fonts/urbanist": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@supabase/supabase-js": "^2.97.0",
    "dotenv": "^17.2.4",
    "expo": "~53.0.27",
    "expo-auth-session": "~6.2.1",
    "expo-av": "~15.1.7",
    "expo-build-properties": "~0.14.0",
    "expo-dev-client": "~5.2.0",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image-picker": "~16.1.4",
    "expo-keep-awake": "~14.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-media-library": "~17.1.7",
    "expo-status-bar": "~2.2.3",
    "expo-video-thumbnails": "~9.1.3",
    "expo-web-browser": "~14.2.0",
    "lucide-react-native": "^0.378.0",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-record-screen": "^0.6.2",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.0",
    "jest": "^29.7.0",
    "patch-package": "^8.0.0",
    "react-native-svg-transformer": "^1.5.3",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "react": "19.0.0"
  },
  "private": true
}

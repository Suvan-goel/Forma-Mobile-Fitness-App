+      android:state_hovered="true" android:state_checked="true"/>
+  <item android:alpha="@dimen/m3_ripple_default_alpha"
+      android:color="?attr/colorPrimary"
+      android:state_checked="true"/>
+
+  <!-- Unchecked. -->
